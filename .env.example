# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# 原始策略最大并发线程数（建议 2-4；baostock 始终保持单连接串行）
STRATEGY_MAX_WORKERS=4

# 统一业务阈值配置文件
THRESHOLDS_CONFIG_PATH=config/thresholds.ini

# 应用日志目录；每天生成一个 sequoia-x-YYYY-MM-DD.log 文件
LOG_DIR=logs
# 应用日志最多保留文件数，超过后自动删除最老文件
LOG_RETENTION_FILES=10

# 组合、持仓和自选股多周期预测跟踪数据库
PREDICTION_TRACKING_DB_PATH=data/prediction_tracking.db
# 组合重点候选连续推送次数状态文件
COMBINED_STREAK_PATH=data/combined_selection_streak.json

# 自选和持仓 CSV 路径
PORTFOLIO_CSV_PATH=data/portfolio.csv

# 收盘综合趋势快照与盘中预警去重状态
COMPREHENSIVE_SNAPSHOT_PATH=data/comprehensive_trend_latest.json
INTRADAY_ALERT_STATE_PATH=data/intraday_alert_state.json

# 默认飞书 Webhook URL（必填，作为 fallback）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-default-token

# 精简后的5类飞书群Webhook；暂不填写时会自动使用默认 FEISHU_WEBHOOK_URL
# 核心决策群：综合趋势、组合决策重点候选、概率预测
STRATEGY_WEBHOOK_CORE_DECISION=
# 原始策略群：均线、海龟、高旗形、涨停洗盘、跌停反转、RPS、定增
STRATEGY_WEBHOOK_ORIGINAL_STRATEGIES=
# 组合管理群：低价多因子、持仓和下一工作日操作观察
STRATEGY_WEBHOOK_PORTFOLIO_MANAGEMENT=
# 盘中交易群：盘中预警、无信号状态、模拟交易成交
STRATEGY_WEBHOOK_INTRADAY_TRADING=
# 系统运维群：baostock登录或同步失败等系统告警
STRATEGY_WEBHOOK_SYSTEM_OPERATIONS=
